{%- doc -%}
  <title>, description, Open Graph and Twitter tags. Each flavour shares its own image:
  the flavour story's share image if set, else the product photo.
{%- enddoc -%}
{%- liquid
  assign title = page_title
  if request.page_type != 'index'
    assign title = 'general.page_title' | t: title: page_title, shop: shop.name
  endif
  if current_page != 1 and current_page != blank
    assign title = 'general.page_title_paged' | t: title: title, page: current_page
  endif
  assign description = page_description | default: settings.meta_description | default: shop.description
  assign og_type = 'website'
  assign share = settings.share_image
  if request.page_type == 'product'
    assign og_type = 'product'
    assign story = product.metafields.custom.flavour_story.value
    if story.share_image != blank
      assign share = story.share_image.value
    else
      assign share = product.featured_image
    endif
  elsif request.page_type == 'article' and article.image != blank
    assign og_type = 'article'
    assign share = article.image
  elsif request.page_type == 'collection' and collection.image != blank
    assign share = collection.image
  endif
-%}
<title>{{ title | strip_html | escape }}</title>
{%- if description != blank %}
<meta name="description" content="{{ description | strip_html | strip_newlines | truncate: 300 | escape }}">
{%- endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | strip_html | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ description | strip_html | strip_newlines | truncate: 300 | escape }}">
{%- if share != blank -%}
  {%- liquid
    assign og_w = 1200
    if share.width < og_w
      assign og_w = share.width
    endif
    assign og_h = share.height | times: og_w | divided_by: share.width
    assign og_image = share | image_url: width: og_w
    assign head = og_image | slice: 0, 2
    if head == '//'
      assign og_image = og_image | prepend: 'https:'
    else
      assign head = og_image | slice: 0, 1
      if head == '/'
        assign og_image = og_image | prepend: request.origin
      endif
    endif
  -%}
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
<meta property="og:image:width" content="{{ og_w }}">
<meta property="og:image:height" content="{{ og_h }}">
<meta property="og:image:alt" content="{{ share.alt | default: page_title | escape }}">
{%- endif -%}
{%- if og_type == 'product' %}
<meta property="og:price:amount" content="{{ product.price | times: 0.01 | round: 2 }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code | default: 'INR' }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | strip_html | escape }}">
<meta name="twitter:description" content="{{ description | strip_html | strip_newlines | truncate: 200 | escape }}">
