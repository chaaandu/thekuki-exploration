  <path class="bag-art__inside" d="M22 28 H98 V46 H22 Z"/>
  <g class="bag-art__cookies">
    <g class="bag-art__cookie bag-art__cookie--1"><circle cx="44" cy="40" r="12"/><circle class="bag-art__fleck" cx="40" cy="37" r="1.6"/><circle class="bag-art__fleck" cx="48" cy="43" r="1.3"/></g>
    <g class="bag-art__cookie bag-art__cookie--2"><circle cx="75" cy="37" r="13"/><circle class="bag-art__fleck" cx="71" cy="33" r="1.5"/><circle class="bag-art__fleck" cx="79" cy="40" r="1.8"/></g>
    <g class="bag-art__cookie bag-art__cookie--3"><circle cx="59" cy="29" r="12"/><circle class="bag-art__fleck" cx="55" cy="27" r="1.4"/><circle class="bag-art__fleck" cx="63" cy="32" r="1.6"/></g>
