<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js" data-page="password">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#fbf4e6">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    {%- render 'fonts' -%}
    {%- render 'critical-css' -%}
    <link rel="stylesheet" href="{{ 'kuki.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body class="password-body">
    {%- render 'svg-sprite' -%}
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
