<section class="password section" aria-labelledby="password-title-{{ section.id }}">
  <div class="empty-jar__art" style="--flavour: #e8650a;">
    {%- render 'jar-art', form: 'chunk', loading: 'eager' -%}
  </div>
  <h1 class="empty-jar__title" id="password-title-{{ section.id }}">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="password__message">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'password__form' -%}
    <label class="field__label" for="password-{{ section.id }}">{{ 'password.label' | t }}</label>
    <div class="password__row">
      <input class="field__input" type="password" id="password-{{ section.id }}" name="password" autocomplete="current-password">
      <button class="btn btn--primary" type="submit">{{ 'password.enter' | t }}</button>
    </div>
    {%- if form.errors -%}<p class="form__status form__status--error" role="alert">{{ 'password.wrong' | t }}</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password",
  "tag": "div",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The jars are being filled." }
  ]
}
{% endschema %}
