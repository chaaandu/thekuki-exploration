<section class="page section" aria-labelledby="collections-title-{{ section.id }}">
  <div class="page__inner">
    <h1 class="page__title" id="collections-title-{{ section.id }}">{{ section.settings.heading }}</h1>
    <ul class="link-list" role="list">
      <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.all_flavours' | t }}</a></li>
      {%- for collection in collections -%}
        {%- unless collection.handle == 'all' or collection.handle == 'frontpage' -%}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
