<section class="search-page section" aria-labelledby="search-title-{{ section.id }}">
  <h1 class="section-head__title section-head__title--page" id="search-title-{{ section.id }}">
    {%- if search.performed -%}
      {{ 'search.results_for' | t: terms: search.terms }}
    {%- else -%}
      {{ section.settings.heading }}
    {%- endif -%}
  </h1>
  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="search-{{ section.id }}">{{ 'general.search_label' | t }}</label>
    <input class="field__input" id="search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="btn btn--primary" type="submit">{{ 'general.search_submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <ul class="counter__grid" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'flavour-card', product: item, image_index: 3, source: 'search', heading_level: 'h2' -%}
            {%- else -%}
              <li class="search-page__item"><a href="{{ item.url }}">{{ item.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="empty-note">{{ 'search.no_results' | t: terms: search.terms }}</p>
        <p><a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'general.all_flavours' | t }}</a></p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "tag": "div",
  "class": "section-search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looking for a flavour?" }
  ]
}
{% endschema %}
