{%- liquid
  assign wa_digits = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign phone_digits = settings.phone_number | remove: ' ' | remove: '-'
  assign reasons = section.blocks | where: 'type', 'reason'
-%}
<section class="contact section" id="contact" aria-labelledby="contact-title-{{ section.id }}">
  <div class="contact__intro">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="contact__title" id="contact-title-{{ section.id }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="contact__text rte">{{ section.settings.text }}</div>{%- endif -%}
    <ul class="contact__direct" role="list">
      {%- if wa_digits != blank -%}
        <li>
          <a class="contact__card" href="https://wa.me/{{ wa_digits }}" rel="noopener" target="_blank">
            <svg class="icon" aria-hidden="true"><use href="#kuki-icon-chat"/></svg>
            <span class="contact__card-label">{{ 'contact.whatsapp' | t }}</span>
            <span class="contact__card-value">{{ settings.whatsapp_number }}</span>
            <span class="visually-hidden">{{ 'accessibility.opens_new_window' | t }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if phone_digits != blank -%}
        <li>
          <a class="contact__card" href="tel:{{ phone_digits }}">
            <svg class="icon" aria-hidden="true"><use href="#kuki-icon-phone"/></svg>
            <span class="contact__card-label">{{ 'contact.call' | t }}</span>
            <span class="contact__card-value">{{ settings.phone_number }}</span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>

  <div class="contact__form-wrap">
    {%- form 'contact', id: 'contact_form', class: 'form contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__status form__status--ok" role="status" tabindex="-1" data-autofocus>
          <svg class="icon" aria-hidden="true"><use href="#kuki-icon-check"/></svg>
          {{ section.settings.success }}
        </p>
      {%- elsif form.errors -%}
        <div class="form__status form__status--error" role="alert" tabindex="-1" data-autofocus>
          <p>{{ 'contact.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#contact-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="contact-name">{{ 'contact.name' | t }}</label>
        <input class="field__input" type="text" id="contact-name" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label class="field__label" for="contact-email">{{ 'contact.email' | t }} <span class="field__req">{{ 'contact.required' | t }}</span></label>
        <input class="field__input" type="email" id="contact-email" name="contact[email]" autocomplete="email" required spellcheck="false" value="{{ form.email }}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
      </div>
      <div class="field">
        <label class="field__label" for="contact-phone">{{ 'contact.phone' | t }}</label>
        <input class="field__input" type="tel" id="contact-phone" name="contact[phone]" autocomplete="tel" inputmode="tel" value="{{ form.phone }}">
      </div>
      {%- if reasons.size > 0 -%}
        <div class="field">
          <label class="field__label" for="contact-topic">{{ section.settings.reasons_label }}</label>
          <div class="field__select">
            <select class="field__input" id="contact-topic" name="contact[topic]">
              {%- for block in reasons -%}
                <option value="{{ block.settings.reason | escape }}" {{ block.shopify_attributes }}>{{ block.settings.reason }}</option>
              {%- endfor -%}
            </select>
            <svg class="icon" aria-hidden="true"><use href="#kuki-icon-chevron-down"/></svg>
          </div>
        </div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="contact-body">{{ 'contact.message' | t }}</label>
        <textarea class="field__input" id="contact-body" name="contact[body]" rows="5">{{ form.body }}</textarea>
      </div>
      <button class="btn btn--primary" type="submit">{{ section.settings.button }}</button>
      {%- if section.settings.privacy != blank -%}<p class="form__fine">{{ section.settings.privacy }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "class": "section-contact",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bulk orders, gifting or a question?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Drop your details and we'll get back to you. Or reach us directly on WhatsApp or the phone.</p>" },
    { "type": "text", "id": "reasons_label", "label": "Reasons dropdown label", "default": "How can we help?" },
    { "type": "text", "id": "button", "label": "Button", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Message after sending", "default": "Thanks, it's with us. We'll reply soon." },
    { "type": "text", "id": "privacy", "label": "Small print", "default": "We'll only use your details to reply to you." }
  ],
  "blocks": [
    { "type": "reason", "name": "Reason", "settings": [{ "type": "text", "id": "reason", "label": "Reason", "default": "Something else" }] }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "reason", "settings": { "reason": "Order or delivery help" } },
        { "type": "reason", "settings": { "reason": "Gifting order" } },
        { "type": "reason", "settings": { "reason": "Bulk / corporate" } },
        { "type": "reason", "settings": { "reason": "Feedback" } },
        { "type": "reason", "settings": { "reason": "Something else" } }
      ]
    }
  ]
}
{% endschema %}
