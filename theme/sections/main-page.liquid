<section class="page section" aria-labelledby="page-title-{{ section.id }}">
  <div class="page__inner">
    <h1 class="page__title" id="page-title-{{ section.id }}">{{ page.title }}</h1>
    {%- if page.content != blank -%}
      <div class="page__content rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "div",
  "class": "section-page"
}
{% endschema %}
