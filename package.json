{
  "name": "kuki-theme",
  "private": true,
  "version": "0.1.0",
  "description": "Kuki — custom Shopify Online Store 2.0 theme for thekuki.in",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,shop -c yellow,cyan \"vite build --watch --mode development\" \"node --watch-path=dev --watch-path=store dev/server.ts\"",
    "serve": "node dev/server.ts",
    "build": "vite build && node scripts/postbuild.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "theme:check": "shopify theme check --path theme",
    "lint:copy": "node scripts/lint-copy.ts",
    "check": "npm run typecheck && npm run lint:copy && npm run theme:check",
    "test": "playwright test",
    "test:dev": "node --test dev/test/*.test.ts",
    "shots": "node scripts/shots.ts",
    "lh": "node scripts/lighthouse.ts",
    "shopify:dev": "shopify theme dev --path theme --store quxv3b-ze.myshopify.com",
    "shopify:push": "shopify theme push --path theme --unpublished --store quxv3b-ze.myshopify.com"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capsizecss/core": "4.1.3",
    "@capsizecss/unpack": "4.0.1",
    "@playwright/test": "1.63.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "concurrently": "10.0.5",
    "liquidjs": "10.30.0",
    "mediabunny": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
